+  memset(name, 'A', sizeof(name));
+  for (size_t index = 0; index < length; index++)
+    name[index] = blob[index] ? (char)blob[index] : 1;
+  if (zero < length)
+    name[zero] = 0;
+  else
+    name[length] = 0;
+  return ioctl(fd, ASHMEM_SET_NAME, name);
