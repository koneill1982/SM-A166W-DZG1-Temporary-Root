+static int qemu_mm_trace_drain(void) {
+  char data[16384];
+
+  if (!qemu_mm_trace_ready()) {
+    return 0;
+  }
+  for (;;) {
+    ssize_t size = read(qemu_mm_trace_fd, data, sizeof(data));
+    if (size > 0) {
+      continue;
+    }
+    if (size < 0 && errno != EAGAIN && errno != EINTR) {
+      pr_error("qemu mm trace drain errno=%d\n", errno);
+      return 0;
+    }
+    return 1;
+  }
