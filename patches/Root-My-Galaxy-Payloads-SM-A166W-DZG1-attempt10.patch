+static pid_t spawn_reclaim(uint64_t slide, int *read_fd) {
+  int pair[2];
+  pid_t child;
+
+  if (pipe2(pair, O_CLOEXEC))
+    die("pipe reclaim");
+  child = fork();
+  if (child < 0)
+    die("fork reclaim");
+  if (!child) {
+    if (dup2(pair[1], STDOUT_FILENO) < 0 || dup2(pair[1], STDERR_FILENO) < 0)
+      _exit(126);
+    close(pair[0]);
+    close(pair[1]);
+    _exit(a536_reclaim_page(slide));
+  }
+  close(pair[1]);
+  *read_fd = pair[0];
+  return child;
+}
