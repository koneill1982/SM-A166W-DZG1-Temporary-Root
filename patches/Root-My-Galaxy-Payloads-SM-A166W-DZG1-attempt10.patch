+static int controlled_mm_valid(uintptr_t mm) {
+  uintptr_t base = mm & ~(ORDER3_SIZE - 1);
+  uintptr_t offset = mm - base;
+
+  return controlled_mm_zone_of(mm) != CONTROLLED_MM_INVALID &&
+         offset < ORDER3_SIZE && offset % MM_STRUCT_SZ == 0;
