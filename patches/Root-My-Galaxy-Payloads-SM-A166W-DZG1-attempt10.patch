+static int valid_mm(uintptr_t mm) {
+  uintptr_t base = mm & ~(ORDER3_SIZE - 1);
+  uintptr_t offset = mm - base;
+
+  return zone_of(mm) != MM_ZONE_INVALID && offset < ORDER3_SIZE &&
+         offset % MM_STRUCT_SZ == 0;
