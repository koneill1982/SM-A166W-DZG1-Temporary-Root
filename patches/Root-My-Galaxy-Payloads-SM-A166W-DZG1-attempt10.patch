+  address.sun_family = AF_UNIX;
+  snprintf(address.sun_path, sizeof(address.sun_path), "%s", ROOT_SOCKET_PATH);
+  ready = connect(fd, (struct sockaddr *)&address, sizeof(address)) == 0;
+  close(fd);
