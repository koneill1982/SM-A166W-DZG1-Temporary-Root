+  if (clock_gettime(CLOCK_MONOTONIC, &now) != 0) {
+    return 0;
+  }
+  snprintf(marker, sizeof(marker), "RMG_A166W_%x_%lx",
+           getpid(), (unsigned long)now.tv_nsec);
+
+  int changed_tracing_on = 0;
+  if (!original_tracing_on) {
+    if (!slide_tracefs_write(tracing_on, "1")) {
+      pr_error("slide trace-marker cannot enable tracing errno=%d\n", errno);
+      return 0;
+    }
+    changed_tracing_on = 1;
+  }
+
+  int marker_cpu = sched_getcpu();
+  int marker_fd = open(trace_marker, O_WRONLY | O_CLOEXEC);
+  int marker_ok = 0;
+  if (marker_fd >= 0) {
+    size_t marker_len = strlen(marker);
+    marker_ok = write(marker_fd, marker, marker_len) ==
+                (ssize_t)marker_len;
+    close(marker_fd);
+  }
+
+  if (changed_tracing_on && !slide_tracefs_write(tracing_on, "0")) {
+    pr_error("slide trace-marker failed to restore tracing_on=0\n");
+    return 0;
+  }
+  if (!marker_ok) {
+    pr_error("slide trace-marker write failed errno=%d\n", errno);
+    return 0;
+  }
+
+  int cpu_count = (int)sysconf(_SC_NPROCESSORS_ONLN);
+  uintptr_t candidate = 0;
+  int found = 0;
+  for (int pass = 0; pass < 2 && !found; pass++) {
+    int first_cpu = pass == 0 ? marker_cpu : 0;
+    int last_cpu = pass == 0 ? marker_cpu + 1 : cpu_count;
+    if (first_cpu < 0 || first_cpu >= cpu_count) {
+      continue;
+    }
+    for (int cpu = first_cpu; cpu < last_cpu && !found; cpu++) {
+      if (pass == 1 && cpu == marker_cpu) {
+        continue;
+      }
+      char path[128];
+      snprintf(path, sizeof(path),
+               SLIDE_TRACEFS_ROOT "/per_cpu/cpu%d/trace_pipe_raw", cpu);
+      int fd = open(path, O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+      if (fd < 0) {
+        continue;
+      }
+      unsigned char page[PAGE_SIZE];
+      ssize_t got;
+      while ((got = read(fd, page, sizeof(page))) > 0) {
+        if (slide_tracefs_parse_marker_page(
+                page, (size_t)got, marker, &candidate)) {
+          found = 1;
+          break;
+        }
+      }
+      close(fd);
+    }
+  }
+
+  if (!found) {
+    pr_error("slide trace-marker record not found\n");
+    return 0;
+  }
+  return slide_commit_stext(KIMAGE_TEXT_BASE + candidate, "tracefs");
+}
