+  if (slide > MAX_PHYSICAL_SLIDE || (slide & (PHYSICAL_SLIDE_ALIGNMENT - 1))) {
+    errno = EPROTO;
+    die("prefetch slide");
+  }
+  printf("SLIDE_PREFETCH value=%#llx\n", (unsigned long long)slide);
+  fflush(stdout);
+  return slide;
+}
