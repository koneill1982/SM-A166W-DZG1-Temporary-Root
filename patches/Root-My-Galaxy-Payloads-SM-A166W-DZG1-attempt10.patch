+  if (base >= MM_DMA32_ALIAS_START && base < MM_DMA32_ALIAS_END) {
+    return CONTROLLED_MM_DMA32;
+  }
+  if (base >= MM_NORMAL_ALIAS_START && base < MM_NORMAL_ALIAS_END) {
+    return CONTROLLED_MM_NORMAL;
+  }
+  return CONTROLLED_MM_INVALID;
+}
